# 大文件：视频素材不入库（GitHub 单文件限 100MB）
*.mp4
*.avi
# 运行产物
game_vision/logs/
game_vision/recordings/
game_vision/harvest/
game_vision/__pycache__/
game_vision/.ndi/
**/__pycache__/
# 本机用户设置（含个人选择，不共享）
game_vision/settings.yaml

# 模板去重工具移出的近似重复模板（可用工具移回）
game_vision/templates/*/_dup/
game_vision/calibration/landmarks/

# 游戏客户端 Unity Addressables 资源（2.2 GB，tools/wz_sprites.py 只读它）
aa/
# 从客户端导出的全怪物精灵图模板库（tools/wz_sprites.py extract-all 可重建，~30 MB）
game_vision/templates/_wz/

# 一键安装的虚拟环境 / 打包输出
.venv/
dist/
